# Copy to .env and fill in values. Restart backend after changes (--reload does not watch .env).

DATABASE_URL=postgresql://ark_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/intelligent_ark
# Optional pool tuning (VERCEL=1 defaults to smaller pools automatically)
# PG_POOL_MIN=0
# PG_POOL_MAX=10
# PG_POOL_TIMEOUT=30

APP_ENV=dev
JWT_SECRET=
ADMIN_INVITE_CODE=

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=

ZHIPU_API_KEY=
ZHIPU_MODEL=
