APP_ENV=prod
JWT_SECRET=
DATABASE_URL=postgresql://ark_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/intelligent_ark
# Vercel Postgres integration may expose POSTGRES_URL instead; db.py accepts both.
# Serverless defaults: PG_POOL_MAX=2 when VERCEL=1; override for dedicated VMs.
# PG_POOL_MIN=0
# PG_POOL_MAX=10
ALLOWED_ORIGINS=https://campus.example.com
ADMIN_INVITE_CODE=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=

# Help / crisis resources (ADM-02). Configure real school numbers or leave empty
# (empty -> missing_hint in dev; never hardcode phones in code).
# HELP_RESOURCES_IS_PLACEHOLDER defaults to 0. Do not put （演示） in labels.
SCHOOL_PSYCH_CENTER_LABEL=学校心理中心
SCHOOL_PSYCH_CENTER_PHONE=
HOTLINE_24H_LABEL=24h 心理援助热线
HOTLINE_24H_PHONE=
EXTRA_HOTLINES_JSON=
APPOINTMENT_LABEL=预约心理咨询
APPOINTMENT_URL=
CRISIS_SUPPORT_MESSAGE=
HELP_RESOURCES_IS_PLACEHOLDER=0

# Claim response windows (POOL-02 / ADM-02). prod enforces minimum 5 minutes.
RED_CLAIM_MINUTES=30
YELLOW_CLAIM_HOURS=24
REASSESS_INTERVAL_DAYS=14,30
